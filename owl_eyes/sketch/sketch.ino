// Owl eyes for the Arduino UNO Q 8x13 LED matrix.
//
// The sketch stores every animation (generated from ../eyes.py) and plays the state that
// Python asks for over the Bridge:
//
//   Bridge.call("eyes", "thinking")   -> true if the state exists, false otherwise
//   Bridge.call("draw", frame_bytes)  -> show one custom frame (Frame(...).to_board_bytes())
//                                        until the next "eyes" call
//
// States: idle, boot, thinking, hint, correct, wrong, listening, sleeping.
// On power-up it plays "boot", then "idle" (random blinks and glances).
//
// APIs used, all from the official examples (github.com/arduino/app-bricks-examples):
//   Arduino_LED_Matrix: begin(), setGrayscaleBits(3), clear(), draw(const uint8_t*)
//     - core-and-foundational/02-led-matrix/01-led-matrix-frame-mcu and 02-led-matrix-frame;
//       draw() takes `const uint8_t *buf` in ArduinoCore-zephyr
//       libraries/Arduino_LED_Matrix/src/Arduino_LED_Matrix.h, so frames can stay in flash.
//   Arduino_RouterBridge: Bridge.begin(), Bridge.provide(name, fn) with a String argument
//     - core-and-foundational/03-bridge-basics/01-call-sketch-function-from-python
//     and with std::vector<uint8_t> - 02-led-matrix/02-led-matrix-frame.
//     Bridge.provide() callbacks run in the Bridge's own thread (Arduino_RouterBridge
//     README), so they only hand a request to loop() through volatile variables.
//   millis(), random(), randomSeed(), micros(): Arduino language reference.

#include <Arduino_RouterBridge.h>
#include <Arduino_LED_Matrix.h>
#include <vector>

Arduino_LED_Matrix matrix;

const uint8_t FRAME_ROWS = 8;
const uint8_t FRAME_COLS = 13;
const uint8_t FRAME_SIZE = FRAME_ROWS * FRAME_COLS;

struct Step  { uint16_t frame; uint16_t ms; };
struct Clip  { uint16_t first; uint16_t count; };
struct State {
  const char* name;
  int16_t intro;       // clip played once on entry, -1 = none
  int16_t loop;        // clip repeated, -1 = none
  uint8_t firstExtra;  // index into EXTRAS
  uint8_t nExtras;     // random interjections (idle blinks, glances)
  uint16_t gapMin, gapMax;   // pause between interjections, ms
  int8_t then;         // state to switch to automatically, -1 = none
  uint32_t afterMs;    // ...after this long in the state (0 = right after the intro)
};

