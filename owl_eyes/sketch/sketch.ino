const uint8_t N_STATES = 8;
const State STATES[N_STATES] = {
  // name, intro, loop, first extra, n extras, gap min, gap max, then, after ms
  {"idle", -1, 0, 0, 9, 1800, 5500, -1, 0},
  {"boot", 7, -1, 9, 0, 0, 0, 0, 0},
