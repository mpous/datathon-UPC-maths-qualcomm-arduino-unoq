  {"listening", 16, 17, 9, 0, 0, 0, -1, 0},
  {"sleeping", 18, 19, 9, 0, 0, 0, -1, 0},
};
const int8_t STATE_IDLE = 0;
const int8_t STATE_BOOT = 1;
// ==== END GENERATED BY eyes.py ====

// ---------------------------------------------------------------- player state
int8_t curState = -1;          // -1 = showing a custom frame from "draw"
int16_t curClip = -1;
uint16_t curStep = 0;
unsigned long stepStart = 0;
unsigned long stateStart = 0;
unsigned long nextExtraAt = 0;

uint8_t custom[FRAME_SIZE] = {0};

// requests from the Bridge thread, consumed in loop()
volatile int8_t pendingState = -1;
volatile bool pendingCustom = false;
volatile bool seeded = false;

void showStep() {
  const Step& s = STEPS[CLIPS[curClip].first + curStep];
  matrix.draw(FRAMES[s.frame]);
  stepStart = millis();
}

void startClip(int16_t clip) {
  curClip = clip;
  curStep = 0;
  showStep();
}

void scheduleExtra() {
  const State& s = STATES[curState];
  if (s.nExtras > 0) nextExtraAt = millis() + random(s.gapMin, s.gapMax + 1);
}

void enterState(int8_t i) {
  curState = i;
  stateStart = millis();
  scheduleExtra();
  const State& s = STATES[i];
  if (s.intro >= 0) startClip(s.intro);
  else if (s.loop >= 0) startClip(s.loop);
  else if (s.then >= 0) enterState(s.then);
}

// Called when the current clip has played its last step.
void clipFinished() {
  const State& s = STATES[curState];
  unsigned long now = millis();
  if (s.then >= 0 && now - stateStart >= s.afterMs) {
    enterState(s.then);
  } else if (s.nExtras > 0 && (long)(now - nextExtraAt) >= 0) {
    scheduleExtra();
    startClip(EXTRAS[s.firstExtra + random(s.nExtras)]);
  } else if (s.loop >= 0) {
    startClip(s.loop);
  } else {
    curClip = -1;                      // nothing more to play: hold the last frame
  }
}

// ---------------------------------------------------------------- Bridge handlers
int8_t findState(const String& name) {
  for (uint8_t i = 0; i < N_STATES; i++) {
    if (name.equalsIgnoreCase(STATES[i].name)) return i;
  }
  return -1;
}

// Python: Bridge.call("eyes", "thinking")
bool eyes(String name) {
  name.trim();
  int8_t i = findState(name);
  if (i < 0) return false;
  if (!seeded) {                       // the first request comes at a random time: good seed
    randomSeed(micros());
    seeded = true;
  }
  pendingState = i;
  return true;
}

// Python: Bridge.call("draw", Frame(grid).to_board_bytes()), as in the skill's example
void draw(std::vector<uint8_t> newFrame) {
  size_t len = min(newFrame.size(), (size_t)FRAME_SIZE);
  memcpy(custom, newFrame.data(), len);
  pendingCustom = true;
}

// ---------------------------------------------------------------- setup / loop
void setup() {
  matrix.begin();
  matrix.setGrayscaleBits(3);          // brightness 0-7, as the frames in eyes.py
  matrix.clear();
  Bridge.begin();
  Bridge.provide("eyes", eyes);
  Bridge.provide("draw", draw);
  enterState(STATE_BOOT);
}

void loop() {
  if (pendingCustom) {
    pendingCustom = false;
    curState = -1;
    curClip = -1;
    matrix.draw(custom);
  }
  if (pendingState >= 0) {
    int8_t req = pendingState;
    pendingState = -1;
    if (req == curState) stateStart = millis();   // same state again: keep playing, restart its timer
    else enterState(req);
  }
  if (curState >= 0 && curClip >= 0) {
    const Step& s = STEPS[CLIPS[curClip].first + curStep];
    if (millis() - stepStart >= s.ms) {
      if (++curStep < CLIPS[curClip].count) showStep();
      else clipFinished();
    }
  }
  delay(5);
}
