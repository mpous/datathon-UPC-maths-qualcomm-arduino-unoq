# Math on the Edge: shared settings for the board scripts and the Python copilot.
# Bash sources this file, and copilot/config.py parses it. Keep it KEY=VALUE.
# Every team starts from the same pinned versions, so results are comparable.

# llama.cpp, pinned to a commit tested on the UNO Q 4 GB (November 2026)
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp
LLAMA_CPP_REF=2cbe0ec429b849a88664e0f62388fc92a5abd699
LLAMA_CPP_DIR=~/llama.cpp

MODELS_DIR=~/models

# Small language model: Qwen3.5 0.8B, Q8_0 (835 MB)
LLM_REPO=bartowski/Qwen_Qwen3.5-0.8B-GGUF
LLM_REVISION=f36b1ea49a332ede8fe5f389bbf5b3575ef71f48
LLM_FILE=Qwen_Qwen3.5-0.8B-Q8_0.gguf
LLM_SHA256=7182e2362766bb9569209bbc24cf1a4cdfbb8ab161babdb2080c84fa62c08c2f
LLM_ALIAS=qwen3.5-0.8b
LLM_PORT=8081
# One slot with 4096 tokens: enough for a problem, its options and a few examples
LLM_CTX=4096
LLM_THREADS=4
# Optional second server that can see images (see the Explorer section of the README)
VISION_PORT=8083

# Embedding model: bge-small-en-v1.5, Q8_0 (37 MB, 384 dimensions)
EMBED_REPO=CompendiumLabs/bge-small-en-v1.5-gguf
EMBED_REVISION=d32f8c040ea3b516330eeb75b72bcc2d3a780ab7
EMBED_FILE=bge-small-en-v1.5-q8_0.gguf
EMBED_SHA256=ec38e8da142596baa913124ae50550de284b6916bf59577ef2f0cb9660c2f514
EMBED_PORT=8082
# bge-small was trained on 512 tokens; longer problem texts are cut
EMBED_CTX=512
EMBED_THREADS=4
# bge-small expects this prefix on search queries, but not on stored documents
EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# Official run rules
TIME_LIMIT_SECONDS=60
SEED=42
# Most common answer in M3Kang high_quality (D, 24.6%): used when a problem times out
FALLBACK_ANSWER=D
